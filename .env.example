# Postgres connection string (Neon: Project > Connect > copy the connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for the /finance dashboard (this is the "test login" you send reviewers)
FINANCE_PASSWORD=change-me

# Optional. Public address of the app, used in links Claude shows.
# On Vercel this is filled in automatically, so you can leave it blank there.
APP_URL=
